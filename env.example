# ==============================================================================
# Delta Robot Workspace - Environment Configuration Template
# Copy this file to `.env` in the root of the repository:
#   cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Settings (apps/web)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional: Port or host of the backend API proxy used during `npm run dev`
# Default: http://127.0.0.1:8000
# API_PROXY_TARGET=http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# 2. Backend Settings (apps/api)
# ------------------------------------------------------------------------------
# The backend verifies JWT tokens sent from the frontend.
# Obtain the JWT Secret from your Supabase Dashboard:
# Project Settings -> API -> JWT Settings -> JWT Secret

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated

# RoboDK Desktop simulation. Defaults shown below.
ROBODK_HOST=127.0.0.1
ROBODK_PORT=20500
ROBODK_STATION_PATH=assets/robodk/delta_robot.rdk


# ------------------------------------------------------------------------------
# IMPORTANT NOTE ON GOOGLE OAUTH KEYS:
# ------------------------------------------------------------------------------
# Google OAuth Client ID and Client Secret DO NOT belong in this `.env` file!
# They must be entered directly into the Supabase Dashboard:
# Authentication -> Providers -> Google -> Enabled -> Paste Client ID & Secret.
#
# In Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID):
# - Authorized JavaScript origins:
#     http://127.0.0.1:5173
#     http://localhost:5173
# - Authorized redirect URIs:
#     https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
# ------------------------------------------------------------------------------
